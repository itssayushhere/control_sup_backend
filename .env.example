# Copy to .env and adjust. Load before running:  set -a; . ./.env; set +a; go run .

# Address the signaling server listens on (host:port; empty host = all interfaces)
ADDR=:8080

# SQLite file holding secret hashes and trusted-device pairs
DB_PATH=controlsup.db

# TLS, so clients can use wss:// directly. Leave empty if a proxy (Caddy, nginx) handles TLS.
TLS_CERT=
TLS_KEY=

# STUN/TURN servers sent to both devices in every `session` message (comma-separated).
ICE_URLS=stun:turn.example.com:3478,turn:turn.example.com:3478
# Must match coturn's `static-auth-secret` (coturn also needs `use-auth-secret`).
# Empty = no TURN credentials are sent.
TURN_SECRET=
